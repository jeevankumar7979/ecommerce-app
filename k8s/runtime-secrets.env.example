# Copy to runtime-secrets.env, replace every placeholder, and protect the file locally.
mongodb-uri=mongodb://replace-user:replace-password@mongo.example.internal:27017/orders?authSource=admin
inventory-db-url=jdbc:postgresql://inventory-db.example.internal:5432/inventory?sslmode=require
inventory-db-username=replace-inventory-user
inventory-db-password=replace-inventory-password
payment-db-url=jdbc:postgresql://payment-db.example.internal:5432/payments?sslmode=require
payment-db-username=replace-payment-user
payment-db-password=replace-payment-password
kafka-bootstrap-servers=kafka.example.internal:9093
jwt-issuer-uri=https://identity.example.com/realms/ecommerce
jwt-jwk-set-uri=https://identity.example.com/realms/ecommerce/protocol/openid-connect/certs
jwt-token-uri=https://identity.example.com/realms/ecommerce/protocol/openid-connect/token
service-client-secret=replace-with-keycloak-client-secret
